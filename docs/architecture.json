  "cards": [
    {
      "dot": "cyan",
      "title": "Interfaces and trace",
      "items": [
        "The Engine yields Events and knows no terminal",
        "CLI / TUI / SDK consume the same stream",
        "events.jsonl is the only source of truth, and replayable"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deliberation core",
      "items": [
        "debate / adversarial / council / ensemble / reflect",
        "plan() plans each round's Phases; Moves run concurrently",
        "StanceMatrix decides the outcome; the rapporteur drafts RESULT"
      ]
    },
    {
      "dot": "amber",
      "title": "Participants and evidence",
      "items": [
        "Participants are agent CLIs and model APIs you already have",
        "A worktree gives each of them their own working copy",
        "self-test / cross-test verify what they changed"
      ]
    }
  ]
